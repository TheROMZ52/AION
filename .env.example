# AION compiler configuration
# Get your API key from OpenRouter and keep the real key in your deployment environment.
OPENROUTER_API_KEY=

# Optional: override the model used by the compiler.
AION_MODEL=openai/gpt-oss-20b:free

# Optional: public URL sent to OpenRouter as the HTTP Referer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
